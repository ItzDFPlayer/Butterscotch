#!/bin/sh
# C compiler for the Miyoo Mini / Mini Plus build (ARMv7 hard-float, glibc 2.17).
#
# Wraps Zig's bundled clang + libc stubs so the produced binary never asks for a
# newer glibc than Onion ships. Set ZIG to override which zig binary is used;
# otherwise tools/miyoo-arm/.zig/zig is used when present, then $PATH.
set -e
here=$(cd "$(dirname "$0")" && pwd)

zig=${ZIG:-}
if [ -z "$zig" ]; then
    if [ -x "$here/.zig/zig" ]; then
        zig="$here/.zig/zig"
    else
        zig=zig
    fi
fi

exec "$zig" cc \
    -target arm-linux-gnueabihf.2.17 \
    -mcpu=cortex_a7 \
    "$@"
